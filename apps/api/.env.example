# Plantilla de configuración. Cópiala a .env y rellena los valores.
#
# El .env real NO se versiona: lleva credenciales. Estuvo versionado hasta
# hoy —con el secreto de JWT y la llave de cifrado dentro— y por eso existe
# este ejemplo: para que el repositorio siga documentando qué hace falta sin
# publicar los valores.

# NexDMS API — Variables de entorno
# Copiar como .env y llenar los valores reales
# NUNCA commitear el .env real

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Base de datos
# Host "postgres" solo resuelve dentro de Docker. Para migraciones desde el host usa localhost.
# El contenedor api usa postgres (sobrescrito en docker-compose).
DATABASE_URL=postgres://usuario:contraseña@postgres:5432/nexdms

# Redis
# Host "redis" solo resuelve dentro de Docker. Para ejecución desde el host usa localhost.
REDIS_URL=redis://redis:6379

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR — cadena larga y aleatoria
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Cifrado AES-256 — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CAMBIAR — 64 caracteres hexadecimales

# Backblaze B2
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET_NAME=nexdms-files
B2_BUCKET_BACKUP=nexdms-backup
B2_KEY_ID=CAMBIAR — keyID de la llave de aplicación de Backblaze
B2_APP_KEY=CAMBIAR — applicationKey; solo se muestra al crearla
B2_KEY_PREFIX=NDMS_
B2_BUCKET_URL=https://f004.backblazeb2.com/file/nexdms-files

# Email (Resend)
RESEND_API_KEY=CAMBIAR
OPS_EMAIL=operaciones@ejemplo.mx

# SMS fallback (Twilio)
TWILIO_SID=CAMBIAR
TWILIO_TOKEN=CAMBIAR
TWILIO_FROM=+1XXXXXXXXXX

# FacturAPI y las credenciales de WhatsApp por sucursal (phone_number_id y
# token) se configuran en la BD, por sucursal. No van aquí.

# WhatsApp — lo que sí es global, porque es de la app de Meta, no de una sucursal
# Token que Meta repite en el GET de verificación del webhook
WHATSAPP_VERIFY_TOKEN=nexdms-verify
# App Secret: con él se valida la firma X-Hub-Signature-256 de cada POST.
# Sin esto en producción el webhook se rechaza — cualquiera podría inyectar
# mensajes falsos.
WHATSAPP_APP_SECRET=CAMBIAR

# Asistente de WhatsApp (Gemini en Vertex AI)
# Un solo proyecto de GCP para todos los clientes: el prompt y el catálogo son
# por sucursal, pero la credencial es una. Sin estas variables el asistente no
# se llama y el bot sigue con su flujo de menús numerados.
#
# ⚠️ GCP_LOCATION está pendiente de decisión legal: define en qué país se
# procesan los datos de los clientes del taller. Resolver antes de producción.
GCP_PROJECT_ID=CAMBIAR
GCP_LOCATION=us-central1
GCP_SA_EMAIL=CAMBIAR
# La llave PEM en una sola línea, con los saltos escapados como \n
GCP_SA_PRIVATE_KEY=CAMBIAR
GEMINI_MODEL=gemini-2.5-flash-lite
