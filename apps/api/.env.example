# NexDMS API — Variables de entorno
# Copiar como .env y llenar los valores reales
# NUNCA commitear el .env real

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Base de datos
# Docker: host=postgres. Local sin Docker: host=localhost
DATABASE_URL=postgresql://nexdms:nexdms_dev@postgres:5432/nexdms

# Redis
REDIS_URL=redis://:nexdms_dev@redis:6379

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_SECRET_REAL
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Cifrado AES-256 — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CAMBIAR_POR_KEY_DE_64_CHARS_HEX

# Backblaze B2
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET_NAME=nexdms-files
B2_BUCKET_BACKUP=nexdms-backup
B2_KEY_ID=CAMBIAR
B2_APP_KEY=CAMBIAR
B2_BUCKET_URL=https://f004.backblazeb2.com/file/nexdms-files

# Email (Resend)
RESEND_API_KEY=CAMBIAR
OPS_EMAIL=ops@nexusqtech.com

# SMS fallback (Twilio)
TWILIO_SID=CAMBIAR
TWILIO_TOKEN=CAMBIAR
TWILIO_FROM=+1XXXXXXXXXX

# WhatsApp (fallback global; por sucursal en branch_config cifrado)
WHATSAPP_PHONE_ID=CAMBIAR
WHATSAPP_TOKEN=CAMBIAR

# FacturAPI se guarda en sucursal_config cifrado en BD
